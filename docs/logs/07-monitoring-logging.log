$ # Query Prometheus HTTP API for scrape health (up) and request counter
$ curl -s 'http://127.0.0.1:19091/api/v1/query?query=up' | jq -c '.data.result[] | {job:.metric.job, up:.value[1]}'
{"job":"cloudledger","up":"1"}
$ curl -s 'http://127.0.0.1:19091/api/v1/query?query=cloudledger_http_requests_total' | jq -c '.data.result[] | {metric:.metric.__name__, value:.value[1]}'
{"metric":"cloudledger_http_requests_total","value":"15"}
$ curl -s 'http://127.0.0.1:19091/api/v1/rules' | jq -c '.data.groups[].rules[] | {alert:.name, state:.state}'
{"alert":"HighErrorRate","state":"inactive"}
{"alert":"ServiceDown","state":"inactive"}

